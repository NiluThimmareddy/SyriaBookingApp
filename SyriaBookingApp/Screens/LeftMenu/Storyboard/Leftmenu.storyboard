                                                        <rect key="frame" x="10" y="90.333333333333314" width="169" height="100.33333333333331"/>
                                                        <string key="text">Use our powerful search engine to explore hotels across Syria. Filter by city, price, star rating, amenities, and guest reviews to find the perfect stay that fits your needs.</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                                        <nil key="textColor"/>
